APP_ENV=local
PORT=8000

DATABASE_URL=postgresql+psycopg://insightsync:insightsync@postgres:5432/insightsync
SQLITE_SOURCE_PATH=insightsync/data/storage/demo/insightsync_demo.db

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# LLM generation / explanation layer
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/paas/v4/
LLM_CHAT_MODEL=glm-4.7-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=45
LLM_ENABLE_THINKING=false

RAG_TOP_K=6
RAG_MIN_SCORE=0.15
ENABLE_LLM_GENERATION=false
ENABLE_LLM_BRIEF_GENERATION=false

CORS_ALLOW_ORIGINS=*
API_KEYS=
RATE_LIMIT_PER_MINUTE=0
